   {
    "t0": 0.3,
    "t1": 4.5,
    "text": "The green ship is the AI. It can move. That is all, plus one button:"
   },
   {
    "t0": 4.8,
    "t1": 9.8,
    "text": "Hold the hook: a harpoon grabs the nearest crystal and swings it around on a rope."
   },
   {
    "t0": 10,
    "t1": 14.5,
    "text": "Let go: the crystal flies off in a straight line."
   },
   {
    "t0": 14.8,
    "t1": 20.6,
    "text": "If it hits another crystal hard enough, that crystal shatters. Every fragment is new ammo."
   },
   {
    "t0": 21,
    "t1": 25.4,
    "text": "Clear the field and the next wave arrives."
   },
   {
    "t0": 25.7,
    "t1": 30.2,
    "text": "Smash fast to build a combo: up to x10 points per smash."
   },
   {
    "t0": 30.5,
    "t1": 35.8,
    "text": "Touch a drifting crystal or an enemy and you lose a life. Three lives."
   }
  ]
